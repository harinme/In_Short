MYSQL_DATABASE=in_short
MYSQL_HOST=in-short-mysql-in-short.h.aivencloud.com
MYSQL_PORT=26973
MYSQL_USER=avnadmin
MYSQL_PASSWORD=change-me
# Aiven requires REQUIRED. Use PREFERRED for the optional local MySQL profile.
MYSQL_SSL_MODE=REQUIRED
MYSQL_ROOT_PASSWORD=change-root-password
JPA_DDL_AUTO=update
JPA_SHOW_SQL=false

REDIS_HOST=your-shared-redis-host
REDIS_PORT=your-shared-redis-port
REDIS_USERNAME=default
REDIS_PASSWORD=change-me
REDIS_SSL_ENABLED=false

BACKEND_PORT=8080
FRONTEND_PORT=3000
