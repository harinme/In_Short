MYSQL_DATABASE=in_short

# Public MySQL (default)
MYSQL_HOST=in-short-mysql-in-short.h.aivencloud.com
MYSQL_PORT=26973
MYSQL_USER=avnadmin
MYSQL_PASSWORD=change-me
MYSQL_SSL_MODE=REQUIRED

# Local Docker MySQL (optional)
# To switch, comment out the five public values above and uncomment these values.
# MYSQL_HOST=mysql
# MYSQL_PORT=3306
# MYSQL_USER=hanmadi
# MYSQL_PASSWORD=local-password
# MYSQL_SSL_MODE=PREFERRED

MYSQL_ROOT_PASSWORD=change-root-password
JPA_DDL_AUTO=update
JPA_SHOW_SQL=false

REDIS_HOST=your-shared-redis-host
REDIS_PORT=your-shared-redis-port
REDIS_USERNAME=default
REDIS_PASSWORD=change-me
REDIS_SSL_ENABLED=false

GROQ_API_KEY=change-me
GROQ_STT_MODEL=whisper-large-v3-turbo
GROQ_STT_LANGUAGE=ko
GROQ_STT_MAX_FILE_SIZE=10MB
GROQ_STT_MAX_REQUEST_SIZE=11MB

BACKEND_PORT=8080
FRONTEND_PORT=3000
